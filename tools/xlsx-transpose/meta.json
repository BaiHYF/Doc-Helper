{
  "name": "xlsx-transpose",
  "title": "行列转置",
  "version": "1.0.0",
  "enabled": true,
  "description": "把 Excel 表格的行列互换（原第一行变第一列），作用于第一个工作表，输出新文件不改原文件",
  "category": ["格式"],
  "inputFiles": {
    "min": 1,
    "max": 1
  },
  "accept": [".xlsx"],
  "parameters": {
    "type": "object",
    "properties": {
      "inputFile": {
        "type": "file",
        "description": "待转置的 xlsx 文件（取第一个工作表）"
      },
      "output": {
        "type": "string",
        "output": true,
        "description": "输出 xlsx 文件路径"
      }
    },
    "required": ["inputFile", "output"]
  }
}
