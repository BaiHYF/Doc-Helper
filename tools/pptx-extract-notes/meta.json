{
  "name": "pptx-extract-notes",
  "title": "提取备注",
  "version": "1.0.0",
  "enabled": true,
  "description": "把 pptx 演示文稿的全部演讲者备注提取为 txt，每条备注之间空行分隔",
  "category": ["格式"],
  "inputFiles": {
    "min": 1,
    "max": 1
  },
  "accept": [".pptx"],
  "parameters": {
    "type": "object",
    "properties": {
      "inputFile": {
        "type": "file",
        "description": "待提取备注的 pptx 文件"
      },
      "output": {
        "type": "string",
        "output": true,
        "description": "输出 txt 文件路径"
      }
    },
    "required": ["inputFile", "output"]
  }
}
