{
  "name": "xlsx-merge-columns",
  "title": "多列合一",
  "version": "1.0.0",
  "enabled": true,
  "description": "把 Excel 的多个指定列合并为一列（用分隔符连接），结果写入第一列，其余列清空，输出新文件不改原文件",
  "category": ["合并"],
  "inputFiles": {
    "min": 1,
    "max": 1
  },
  "accept": [".xlsx"],
  "parameters": {
    "type": "object",
    "properties": {
      "inputFile": {
        "type": "file",
        "description": "待处理的 xlsx 文件（取第一个工作表）"
      },
      "columns": {
        "type": "string",
        "description": "要合并的列：列号或表头列名，多个用逗号分隔，如 “姓,名” 或 “1,2”"
      },
      "delimiter": {
        "type": "string",
        "description": "合并分隔符（默认空格）"
      },
      "output": {
        "type": "string",
        "output": true,
        "description": "输出 xlsx 文件路径"
      }
    },
    "required": ["inputFile", "columns", "output"]
  }
}
