{
  "name": "pptx-extract-text",
  "title": "提取文本",
  "version": "1.0.0",
  "enabled": true,
  "description": "把 pptx 演示文稿的全部幻灯片文本（标题+文本框内容，不含备注）提取为 txt，按幻灯片分行",
  "category": ["格式"],
  "inputFiles": {
    "min": 1,
    "max": 1
  },
  "accept": [".pptx"],
  "parameters": {
    "type": "object",
    "properties": {
      "inputFile": {
        "type": "file",
        "description": "待提取的 pptx 文件"
      },
      "output": {
        "type": "string",
        "output": true,
        "description": "输出 txt 文件路径"
      }
    },
    "required": ["inputFile", "output"]
  }
}
